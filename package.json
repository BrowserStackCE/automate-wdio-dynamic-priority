{
  "name": "winona-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "local:web": "wdio run ./configs/local/config-local-web.js ",
    "local:git": "wdio run ./configs/local/config-local-git.js ",
    "local:mobile:android": "cross-env DEVICE=mobile-android ENVIRONMENT=staging wdio run ./configs/wdio.conf.js",
    "bstack:mobile": "npm run waitForSlot && wdio run ./configs/browserstack/config-bstack-mobile.js",
    "bstack:desktop": "npm run waitForSlot && wdio run ./configs/browserstack/config-bstack-web.js",
    "bstack:mobile:prio1": "npm run waitForSlot &&  wdio run ./configs/browserstack/config-bstack-mobile-p1.js",
    "bstack:tablet:prio1": "npm run waitForSlot &&  wdio run ./configs/browserstack/config-bstack-tablet-p1.js",
    "bstack:desktop:prio1": "npm run waitForSlot &&  wdio run ./configs/browserstack/config-bstack-web-p1.js",
    "bstack:prio1": "npm run waitForSlot &&  run-s -c \"bstack:mobile:prio1 -- {@}\" \"bstack:desktop:prio1 -- {@}\" --",
    "bstack:mobile:android": "npm run waitForSlot &&  wdio run ./configs/browserstack/config-bstack-mobile-android.js",
    "bstack:mobile:latest": "npm run waitForSlot && wdio run ./configs/browserstack/config-bstack-mobile-latest.js",
    "bstack:desktop:latest": "npm run waitForSlot && wdio run ./configs/browserstack/config-bstack-web-latest.js",
    "bstack:debug": "npm run waitForSlot && wdio run ./configs/browserstack/config-bstack-debug.js",
    "bstack:all": "npm run waitForSlot &&  run-s -c \"bstack:mobile -- {@}\" \"bstack:desktop -- {@}\" --",
    "bstack:all:latest": "npm run waitForSlot && run-s -c \"bstack:mobile:latest -- {@}\" \"bstack:desktop:latest -- {@}\" --",
    "bstack:api:test": "npm run waitForSlot && wdio run ./configs/browserstack/config-api-test.js",
    "bstack:run:test": "npm run waitForSlot && wdio run ./configs/browserstack/config-test-strat-runner.js",
    "generate-report": "npx allure generate allure-results --clean && npx allure open",
    "generate-specs": "npm run cleanup-specs && node ./shared/generateSpecs.js",
    "cleanup-specs": "node ./shared/deleteSpecs.js",
    "generate-api-specs": "node ./shared/template/default-dosage.js",
    "generate-smoke-ui-specs": "node ./shared/template/patient-onboarding/hrt-and-non-hrt-onboarding-template-st.js",
    "generate-onboarding-ui-specs": "node ./shared/template/patient-onboarding-runner.js",
    "generate-peanut-allergy-ui-specs": "node ./shared/template/peanut-allergy-prescription-cancelled-template.js",
    "generate-minoxidil-pricing-ui-specs": "node ./shared/template/minoxidil-pricing-logic-template.js",
    "generate-patient-dashboard-ui-specs": "node ./shared/template/patient-dashboard/generate-files.js",
    "generate-doctor-dashboard-ui-specs": "node ./shared/template/doctor-dashboard/generate-files.js",
    "waitForSlot": "node ./configs/waitForSlot.js",
    "clean-ui-specs": "node ./shared/template/patient-onboarding-cleaner.js",
    "cancel-patients": "npm run waitForSlot && node ./configs/hooks/cancel_patients.js",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "prepare": "husky",
    "bstack:priority": "npm run waitForSlot && node ./configs/run-tests.js"
  },
  "keywords": [],
  "author": "lou tadeo",
  "license": "ISC",
  "devDependencies": {
    "@wdio/allure-reporter": "~8.16.14",
    "@wdio/appium-service": "~8.16.18",
    "@wdio/browserstack-service": "^8.16.22",
    "@wdio/cli": "~8.22.1",
    "@wdio/local-runner": "~8.16.16",
    "@wdio/mocha-framework": "~8.16.15",
    "@wdio/spec-reporter": "~8.16.12",
    "allure-commandline": "^2.24.0",
    "appium": "^2.1.3",
    "appium-uiautomator2-driver": "^2.29.10",
    "concurrently": "^10.0.5",
    "eslint-plugin-wdio": "^9.16.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all": "^4.1.5",
    "prettier": "3.7.4",
    "socket.io-client": "^4.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "us-state-codes": "^1.1.2",
    "wdio-intercept-service": "^4.4.0",
    "wdio-video-reporter": "^4.0.5",
    "wdio-wait-for": "^3.0.7",
    "webdriverio": "^8.32.4"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "chai": "^4.3.10",
    "chance": "^1.1.11",
    "dotenv": "^16.3.1",
    "glob": "^13.0.6",
    "us-state-codes": "^1.1.2",
    "wd": "^1.14.0"
  },
  "lint-staged": {
    "**/*.{js,mjs,ts,json,md}": [
      "npx prettier . --write"
    ],
    "**/*.{js,mjs,ts}": [
      "npx eslint . --fix"
    ]
  }
}
